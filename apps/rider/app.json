{
  "expo": {
    "name": "Food-Dash Rider",
    "slug": "food-dash-rider",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "ph.fooddash.rider"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Food-Dash shares your location with the customer while you are delivering their order.",
          "locationWhenInUsePermission": "Food-Dash shows the customer where their order is while you deliver it.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11e99157-d4ca-44d1-9fba-1ea491bcdeab"
      }
    },
    "owner": "akosikyle143"
  }
}
